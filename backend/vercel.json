{
    "version": 2,
    "buildCommand": "npm install && npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/**/*.js": {
            "runtime": "@vercel/node@3"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/server"
        }
    ]
}